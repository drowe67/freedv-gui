-    Semaphore sem_;
+    int chunkSize_; // samples in 10 ms
+
+    // Samples left over from the previous call that didn't make a full chunk.
+    std::unique_ptr<short[]> partialChunk_;
+    int partialChunkSize_;
 };
 
 #endif // AUDIO_PIPELINE__TAP_STEP_H
