+// Records every chunk the tap hands it.
+class ChunkRecorderStep : public IPipelineStep
+{
+public:
+    virtual int getInputSampleRate() const FREEDV_NONBLOCKING { return 8000; }
+    virtual int getOutputSampleRate() const FREEDV_NONBLOCKING { return 8000; }
+    virtual short* execute(short* inputSamples, int numInputSamples, int* numOutputSamples) FREEDV_NONBLOCKING
+    {
+        chunkSizes.push_back(numInputSamples);
+        samples.insert(samples.end(), inputSamples, inputSamples + numInputSamples);
+        *numOutputSamples = 0;
+        return nullptr;
+    }
+
+    std::vector<int> chunkSizes;
+    std::vector<short> samples;
+};
+
+bool tapDeliversExact10msChunks()
+{
+    ChunkRecorderStep* step = new ChunkRecorderStep;
+    TapStep tapStep(8000, step);
+
+    // 8000 Hz: 10 ms = 80 samples. Feed 25 ms, 15 ms, 1 sample, 39 samples (= 80 total
+    // after the first 200), then 0.
+    const int blocks[] = { 200, 120, 1, 39, 0 };
+    std::vector<short> fed;
+    short next = 0;
+    for (int n : blocks)
+    {
+        std::vector<short> block(n);
+        for (auto& x : block) { x = next++; }
+        fed.insert(fed.end(), block.begin(), block.end());
+        int outputSamples = -1;
+        auto result = tapStep.execute(block.data(), n, &outputSamples);
+        if (outputSamples != n || result != block.data())
+        {
+            std::cerr << "[output doesn't pass input through]...";
+            return false;
+        }
+    }
+
+    // 360 samples fed = 4 full chunks, nothing left over.
+    if (step->chunkSizes != std::vector<int>({ 80, 80, 80, 80 }))
+    {
+        std::cerr << "[expected 4 chunks of 80, got " << step->chunkSizes.size() << " chunks]...";
+        return false;
+    }
+    if (step->samples != std::vector<short>(fed.begin(), fed.begin() + 320))
+    {
+        std::cerr << "[tapped samples differ from input]...";
+        return false;
+    }
+    return true;
+}
+
